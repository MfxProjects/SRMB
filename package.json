{
  "name": "srmb-desktop",
  "version": "1.0.0",
  "description": "SRMB desktop presentation app",
  "main": "electron/main.cjs",
  "author": "SRMB",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && cmd /c \"robocopy assets dist\\assets /E /XF *.__backup__.mp4 *.__compressed__.mp4 /R:1 /W:1 & if %ERRORLEVEL% LEQ 1 exit /b 0 else exit /b %ERRORLEVEL%\"",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "desktop:kiosk": "set SRMB_KIOSK=1 && npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "playwright-core": "^1.59.1"
  },
  "build": {
    "appId": "com.srmb.desktop",
    "productName": "SRMB",
    "directories": {
      "output": "C:\\\\Users\\\\TAAZA14\\\\Desktop\\\\SRMB-Installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SRMB"
    }
  }
}
